# Dependencies and build output
node_modules/
dist/
*.tsbuildinfo
*.tgz
.pnpm-store/

# Prompt/data copies prepared for the npm tarball by scripts/sync-assets.mjs
packages/core/prompts/
packages/core/data/

# Local scratch state
.cache/
.tmp/
coverage/
.harnmem-test/
spikes/**/tmp-home/
.tmp-hermes-home/
.tmp-hermes-store/

# Logs and OS noise
*.log
.DS_Store
Thumbs.db

# Python bytecode (the Hermes plugin is a Python package)
__pycache__/
*.pyc

# Generated deterministically by evals/gen/generate.mjs (verify with `node evals/gen/generate.mjs --check`)
evals/corpora/
evals/results/logs/
evals/results/*.json

# Never commit a real memory home: it may contain personal data
.harnmem/
