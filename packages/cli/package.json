{
  "name": "@harnmem/cli",
  "version": "0.4.2",
  "description": "CLI for HarnMem, the cross-harness agent memory: inspect, edit, search and consolidate the shared store of plain, human-editable Markdown under ~/.harnmem. Idempotent importers for DSH, pi, ZCode and Claude Code sessions, Markdown, JSON/JSONL/stdin, with auto-discovery. No server, no vector database, no embedding model.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "agent-memory",
    "cli",
    "memory",
    "migration",
    "harnmem",
    "cross-harness"
  ],
  "bin": {
    "harnmem": "./dist/main.js"
  },
  "main": "./dist/main.js",
  "exports": {
    ".": "./dist/main.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@harnmem/core": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ys118/harnmem.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/ys118/harnmem/tree/master/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/ys118/harnmem/issues"
  },
  "author": "HarnMem contributors"
}
