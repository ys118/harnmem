{
  "name": "@harnmem/cli",
  "version": "0.3.0",
  "description": "HarnMem command-line interface: memory CRUD, search, consolidation and idempotent migration importers (DSH, pi, ZCode, Claude Code, Markdown, JSON/JSONL/stdin, auto-discovery).",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "agent-memory",
    "cli",
    "memory",
    "migration",
    "harnmem"
  ],
  "bin": {
    "harnmem": "./dist/main.js"
  },
  "main": "./dist/main.js",
  "exports": {
    ".": "./dist/main.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@harnmem/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ys118/harnmem.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/ys118/harnmem/tree/master/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/ys118/harnmem/issues"
  },
  "author": "HarnMem contributors"
}
