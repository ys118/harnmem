{
  "name": "pi-harnmem",
  "version": "0.4.0",
  "description": "HarnMem memory extension for the pi coding agent: byte-stable hot-index injection, memory tools, and session-end extraction.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "memory",
    "harnmem"
  ],
  "pi": {
    "extensions": [
      "./pi-harnmem.js"
    ]
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "pi-harnmem.js",
    "dist/",
    "README.md"
  ],
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@harnmem/core": "workspace:*"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.3.0 <2.0.0",
    "@earendil-works/pi-coding-agent": ">=1.3.0 <2.0.0",
    "typebox": "^1.3.27"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "typebox": "1.3.27"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ys118/harnmem.git",
    "directory": "packages/pi-harnmem"
  },
  "homepage": "https://github.com/ys118/harnmem/tree/master/packages/pi-harnmem#readme",
  "bugs": {
    "url": "https://github.com/ys118/harnmem/issues"
  },
  "author": "HarnMem contributors"
}
