{
  "name": "cursor-harnmem",
  "version": "0.1.4",
  "private": false,
  "type": "module",
  "description": "Cursor plugin for HarnMem, the cross-harness agent memory: byte-stable first-prompt injection, five MCP memory tools, and session-end journaling. One shared store of plain, human-editable Markdown under ~/.harnmem — no server, no vector database, no embedding model.",
  "keywords": [
    "cursor",
    "memory",
    "agent-memory",
    "mcp",
    "harnmem",
    "cross-harness"
  ],
  "license": "MIT",
  "files": [
    ".cursor-plugin/",
    "mcp.json",
    "logo.png",
    "hooks/",
    "mcp/",
    "rules/",
    "commands/",
    "lib/",
    "vendor/",
    "scripts/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/vendor.mjs",
    "test": "node --test test/*.test.mjs",
    "install-cursor": "node scripts/install.mjs"
  },
  "devDependencies": {
    "@harnmem/core": "workspace:*"
  },
  "engines": {
    "node": ">=22.15"
  },
  "bin": {
    "cursor-harnmem": "scripts/install.mjs",
    "cursor-harnmem-install": "scripts/install.mjs"
  }
}
