{
  "name": "harnmem-monorepo",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Monorepo for HarnMem: cross-harness, file-native agent memory.",
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @harnmem/core build && pnpm --filter @harnmem/cli build && node --test packages/core/test/*.test.mjs packages/cli/test/*.test.mjs",
    "sync-assets": "node scripts/sync-assets.mjs",
    "eval": "node evals/run.mjs",
    "eval:gate": "node evals/run.mjs --gate",
    "eval:report": "node evals/run.mjs --report"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ys118/harnmem.git"
  },
  "homepage": "https://github.com/ys118/harnmem#readme",
  "bugs": {
    "url": "https://github.com/ys118/harnmem/issues"
  },
  "author": "HarnMem contributors"
}
